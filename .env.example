# Application
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# Database
DB_DRIVER=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=fdia_user
DB_PASSWORD=changeme
DB_NAME=fdia_db

# OCR & AI
OCR_ENGINE=paddleocr
AI_MODEL_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# WhatsApp Automation
WA_CHROME_PATH=/path/to/chrome
WA_HEADLESS=false

# File Storage
STORAGE_BASE_PATH=./data
MAX_FILE_SIZE_MB=100

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/fdia.log

# API
API_HOST=0.0.0.0
API_PORT=8000

# Desktop
DESKTOP_HOST=127.0.0.1
DESKTOP_PORT=8501

# Email (Optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-password

# Slack Notifications (Optional)
SLACK_WEBHOOK_URL=
